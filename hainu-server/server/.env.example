# 海大工坊后端环境变量模板 — 复制为 .env 后按环境填写
# 数据库（MySQL 8.0）
DATABASE_URL=mysql://user:password@localhost:3306/hainu_workshop
# Redis（当前代码未强依赖，预留）
REDIS_URL=redis://localhost:6379
# JWT 密钥与有效期
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
JWT_ADMIN_ACCESS_EXPIRES=24h
JWT_ADMIN_REFRESH_EXPIRES=7d
# 微信小程序（授权登录用，测试环境可留占位）
WX_APPID=wx0000000000000000
WX_APP_SECRET=your_app_secret_here
# 文件上传
FILE_UPLOAD_DIR=./uploads
FILE_BASE_URL=http://localhost:3000
# 服务
CORS_ORIGIN=*
PORT=3000
# 请求频率限制（次/分钟，预留）
RATE_LIMIT_GENERAL=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOTTERY=5
